<UserControl x:Class="Analysis.Kio.Play.Views.PlayView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:prism="http://prismlibrary.com/"
xmlns:controls="clr-namespace:Analysis.UI.Common.Controls;assembly=Analysis.UI.Common"
prism:ViewModelLocator.AutoWireViewModel="True"
Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Board area -->
            <ColumnDefinition Width="*" MinWidth="400"/>
            <!-- Side panel - 2 columns -->
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Board column -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <!-- Opponent info + clock -->
                <RowDefinition Height="48"/>
                <!-- Board -->
                <RowDefinition Height="*"/>
                <!-- Player info + clock -->
                <RowDefinition Height="48"/>
                <!-- Action buttons -->
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Opponent (top) -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}"
                    Padding="12 6" Margin="0 0 0 4">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#9822;" FontSize="20"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   Margin="0 0 8 0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding OpponentName}"
                                       Style="{DynamicResource BodyTextStyle}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OpponentEloDisplay}"
                                       Style="{DynamicResource MutedTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Opponent clock -->
                    <TextBlock Text="{Binding OpponentClock}"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="20" FontFamily="Consolas"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Board control -->
            <controls:BoardControl Grid.Row="1"
                                   DataContext="{Binding Board}"
                                   Margin="0 4"/>

            <!-- Player (bottom) -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}"
                    Padding="12 6" Margin="0 4 0 0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#9812;" FontSize="20"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0 0 8 0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding PlayerName}"
                                       Style="{DynamicResource BodyTextStyle}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PlayerColorDisplay}"
                                       Style="{DynamicResource MutedTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Player clock -->
                    <TextBlock Text="{Binding PlayerClock}"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="20" FontFamily="Consolas"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0 8 0 0">
                <Button Content="New Game"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding NewGameCommand}"
                        Margin="0 0 8 0"/>
                
                <!-- Import/Export Menu -->
                <Menu Background="Transparent" VerticalAlignment="Center" Margin="0 0 8 0">
                    <MenuItem Padding="10 6">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,2 L14,2 M2,6 L10,6 M2,10 L12,10 M2,14 L8,14" 
                                      Stroke="{DynamicResource ForegroundBrush}" 
                                      StrokeThickness="1.5"
                                      Margin="0 0 6 0"
                                      Width="12" Height="12"
                                      Stretch="Uniform"/>
                                <TextBlock Text="Import/Export" VerticalAlignment="Center"/>
                                <Path Data="M0,0 L4,4 L0,8" 
                                      Fill="{DynamicResource ForegroundBrush}"
                                      Margin="6 0 0 0"
                                      Width="6" Height="8"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="Load PGN..." Command="{Binding LoadPgnCommand}">
                            <MenuItem.Icon>
                                <Path Data="M4,2 L4,14 M4,2 L10,2 L12,4 L12,14 L4,14 M10,2 L10,4 L12,4" 
                                      Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Paste PGN..." Command="{Binding PastePgnCommand}">
                            <MenuItem.Icon>
                                <Path Data="M2,2 L2,10 L6,10 L6,2 Z M6,6 L10,6 L10,14 L6,14" 
                                      Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                      Width="12" Height="14" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Load FEN..." Command="{Binding LoadFenCommand}">
                            <MenuItem.Icon>
                                <Path Data="M2,2 L14,2 M2,6 L10,6 M2,10 L12,10 M2,14 L8,14" 
                                      Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Save PGN..." Command="{Binding SavePgnCommand}">
                            <MenuItem.Icon>
                                <Path Data="M2,2 L2,14 L14,14 L14,6 L10,2 Z M10,2 L10,6 L14,6 M4,9 L12,9 M4,11 L12,11" 
                                      Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy PGN" Command="{Binding CopyPgnCommand}">
                            <MenuItem.Icon>
                                <Path Data="M2,2 L2,10 L6,10 L6,2 Z M6,6 L10,6 L10,14 L6,14" 
                                      Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                      Width="12" Height="14" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy FEN" Command="{Binding CopyFenCommand}">
                            <MenuItem.Icon>
                                <Path Data="M2,2 L14,2 M2,6 L10,6 M2,10 L12,10 M2,14 L8,14" 
                                      Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>
                
                <Button Content="Undo"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding UndoCommand}"
                        Margin="0 0 4 0"/>
                <Button Content="Redo"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding RedoCommand}"
                        Margin="0 0 8 0"/>
                <Button Content="Resign"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding ResignCommand}"
                        Margin="0 0 8 0"/>
                <Button Content="Draw"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding OfferDrawCommand}"
                        Margin="0 0 8 0"/>
                <Button Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding AnalyzeGameCommand}"
                        ToolTip="Open game in Analyzer application"
                        Padding="10 6">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M10,0 A5,5 0 1,1 0,5 A5,5 0 1,1 10,5 M8.5,8.5 L12,12" 
                              Stroke="White" 
                              StrokeThickness="2"
                              Stretch="Uniform" 
                              Width="14" Height="14"
                              Margin="0 0 6 0"/>
                        <TextBlock Text="Analyze" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Side panel - 2 columns -->
        <Grid Grid.Column="1" Margin="0 16 16 16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left column: Evaluation, Move classifications, Opening, Status -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Board Evaluation Card -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 8">
                        <StackPanel>
                            <TextBlock Text="EVALUATION" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 4"/>
                            <TextBlock Text="{Binding BoardEvaluation}"
                                       Style="{DynamicResource HeadingStyle}"
                                       FontSize="28"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Player's Last Move Classification Card -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 8"
                            Visibility="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="YOUR LAST MOVE" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 4"/>
                            <Grid Margin="0 0 0 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Margin="0 0 6 0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                                    </Border.Background>
                                    <Path Data="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToIconPathConverter}}" 
                                          Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8 4">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToTextConverter}}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Border CornerRadius="4" Padding="6 4" Background="{DynamicResource SurfaceAltBrush}"
                                    Visibility="{Binding HasPlayerBestMoveSequence, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Better was:" Style="{DynamicResource MutedTextStyle}" FontSize="9" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding PlayerBestMoveSequence}" FontSize="10" FontFamily="Consolas" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Engine's Last Move Classification Card -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 8"
                            Visibility="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="ENGINE'S LAST MOVE" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Margin="0 0 6 0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                                    </Border.Background>
                                    <Path Data="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToIconPathConverter}}" 
                                          Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8 4">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToTextConverter}}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Current Opening Card -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 8"
                            Visibility="{Binding HasOpeningData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0 0 0 4">
                                <TextBlock Text="OPENING" Style="{DynamicResource SubHeadingStyle}"/>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4 2" HorizontalAlignment="Right"
                                        Visibility="{Binding CurrentOpeningECO, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CurrentOpeningECO}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding CurrentOpeningName}" Style="{DynamicResource BodyTextStyle}" 
                                       FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0 0 0 2"/>
                            <TextBlock Text="{Binding CurrentOpeningMoves}" Style="{DynamicResource MutedTextStyle}" 
                                       FontSize="9" FontFamily="Consolas" TextWrapping="Wrap" Margin="0 0 0 2"/>
                            <Border Background="#F0C15C" CornerRadius="3" Padding="4 2" HorizontalAlignment="Left"
                                    Visibility="{Binding IsOutOfBook, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="OUT OF BOOK" Foreground="White" FontWeight="Bold" FontSize="8"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Status Card -->
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="STATUS" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 4"/>
                            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource BodyTextStyle}" FontSize="11" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0 6 0 0"
                                        Visibility="{Binding IsEngineThinking, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Width="14" Height="14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                        CornerRadius="7" Margin="0 0 6 0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform/></Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <TextBlock Text="Thinking..." Style="{DynamicResource MutedTextStyle}" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Right column: Move list -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="MOVES" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding MoveList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                              BorderThickness="0"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="False"
                              FontSize="11"
                              Foreground="{DynamicResource ForegroundBrush}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
                                <Setter Property="Padding" Value="4 2"/>
                                <Setter Property="FontSize" Value="10"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="24"/>
                            <DataGridTextColumn Header="White" Binding="{Binding White}" Width="*"/>
                            <DataGridTextColumn Header="Black" Binding="{Binding Black}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Game-over overlay -->
        <Border Grid.ColumnSpan="2"
                Background="#BB000000"
                Visibility="{Binding ShowGameOverOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="40 32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="300">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding GameResultText}"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding GameResultDetail}"
                               Style="{DynamicResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="New Game"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding NewGameCommand}"
                                Margin="0 0 8 0"/>
                        <Button Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding AnalyzeGameCommand}"
                                Margin="0 0 8 0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M10,0 A5,5 0 1,1 0,5 A5,5 0 1,1 10,5 M8.5,8.5 L12,12" 
                                      Stroke="White" 
                                      StrokeThickness="2"
                                      Stretch="Uniform" 
                                      Width="14" Height="14"
                                      Margin="0 0 6 0"/>
                                <TextBlock Text="Analyze Game" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Review Board"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding DismissGameOverCommand}"
                                ToolTip="Close this dialog and review the final position"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
