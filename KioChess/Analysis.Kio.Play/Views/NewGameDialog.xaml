<Window x:Class="Analysis.Kio.Play.Views.NewGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Analysis.Kio.Play.ViewModels"
        Title="New Game"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{DynamicResource ShellWindowStyle}">

    <Window.DataContext>
        <vm:NewGameDialogViewModel/>
    </Window.DataContext>

    <StackPanel Margin="24">

        <!-- Colour selection -->
        <TextBlock Text="PLAY AS" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
        <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 16" Padding="12 10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="&#9812;  White"
                             IsChecked="{Binding PlayAsWhite}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             Margin="0 0 24 0"/>
                <RadioButton Content="&#9820;  Black"
                             IsChecked="{Binding PlayAsWhite, Converter={StaticResource InverseBoolConverter}}"
                             Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <!-- Difficulty -->
        <TextBlock Text="DIFFICULTY" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
        <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 16" Padding="12 10">
            <StackPanel>
                <ComboBox Style="{DynamicResource ThemedComboBoxStyle}"
                          ItemsSource="{Binding EloProfiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="DisplayLabel"
                          Margin="0 0 0 8"/>
                <TextBlock Style="{DynamicResource MutedTextStyle}"
                           FontSize="11"
                           TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Target ELO {0} | Think time {1} ms">
                            <Binding Path="SelectedProfile.TargetElo"/>
                            <Binding Path="SelectedProfile.ThinkTimeMs"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Local Engine Option -->
        <TextBlock Text="ADVANCED" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
        <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 24" Padding="12 10">
            <StackPanel>
                <CheckBox Content="Play against local engine (Application.exe)"
                          IsChecked="{Binding PlayAgainstLocalEngine}"
                          Style="{DynamicResource ThemedCheckBoxStyle}"
                          Margin="0 0 0 4"/>
                <TextBlock Style="{DynamicResource MutedTextStyle}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Text="When enabled, starts the local chess engine (Application.exe) to play against."/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Margin="0 0 8 0"/>
            <Button Content="Start Game"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>