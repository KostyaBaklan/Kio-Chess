<common:AnalysisApp x:Class="Analysis.Kio.Play.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Analysis.UI.Common;assembly=Analysis.UI.Common">
    <common:AnalysisApp.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Value converters -->
                <ResourceDictionary Source="pack://application:,,,/Analysis.UI.Common;component/Converters/Converters.xaml"/>
                <!-- Piece vector geometry sets -->
                <ResourceDictionary Source="pack://application:,,,/Analysis.UI.Common;component/Themes/PieceGeometries.xaml"/>
                <!-- Move classifications -->
                <ResourceDictionary Source="pack://application:,,,/Analysis.UI.Common;component/Resources/MoveClassifications.xaml"/>
                <!-- Global control styles -->
                <ResourceDictionary Source="pack://application:,,,/Analysis.UI.Common;component/Themes/ControlStyles.xaml"/>
                <!-- Default theme -->
                <ResourceDictionary Source="pack://application:,,,/Analysis.UI.Common;component/Themes/ClassicWood/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </common:AnalysisApp.Resources>
</common:AnalysisApp>
