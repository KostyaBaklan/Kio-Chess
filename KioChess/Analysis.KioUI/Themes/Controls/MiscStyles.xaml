<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === Fallback Piece Colors ================================= -->
    <!-- Themes can override these with their own palette -->
    <SolidColorBrush x:Key="PieceWhiteFill"   Color="#F0EAD6"/>
    <SolidColorBrush x:Key="PieceWhiteStroke" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="PieceBlackFill"   Color="#1A1A1A"/>
    <SolidColorBrush x:Key="PieceBlackStroke" Color="#F0EAD6"/>

    <!-- === Card Border =========================================== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="12"/>
    </Style>

</ResourceDictionary>
