<Window x:Class="Analysis.KioUI.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:prism="http://prismlibrary.com/"
xmlns:views="clr-namespace:Analysis.KioUI.Views"
xmlns:behaviors="clr-namespace:Analysis.KioUI.Behaviors"
mc:Ignorable="d"
Style="{DynamicResource ShellWindowStyle}"
behaviors:WindowChromeBehavior.EnableCustomChrome="True"
Icon="Resources/Icons/chess-analysis-1.ico"
Title="Kio Chess Analysis"
Height="750" Width="1280"
MinHeight="600" MinWidth="900"
WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0 0 0 1">
            <Grid Margin="16 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#9812;" FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <TextBlock Text="Kio Chess Analysis"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="15"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0 0 4 0">
                    <TextBlock Text="Theme:"
                               Style="{DynamicResource MutedTextStyle}"
                               VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <ComboBox Style="{DynamicResource ThemedComboBoxStyle}"
                              Width="140" Height="28"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding ActiveTheme}"
                              DisplayMemberPath="DisplayName"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main tab control -->
        <TabControl Grid.Row="1"
                    Style="{DynamicResource MainTabControlStyle}"
                    TabStripPlacement="Top">

            <TabItem Style="{DynamicResource MainTabItemStyle}">
                <TabItem.Header>Play</TabItem.Header>
                <views:PlayView/>
            </TabItem>

            <TabItem Style="{DynamicResource MainTabItemStyle}">
                <TabItem.Header>Analyse</TabItem.Header>
                <views:AnalyseView/>
            </TabItem>

            <TabItem Style="{DynamicResource MainTabItemStyle}">
                <TabItem.Header>Opening Explorer</TabItem.Header>
                <views:OpeningExplorerView/>
            </TabItem>

            <TabItem Style="{DynamicResource MainTabItemStyle}">
                <TabItem.Header>Library</TabItem.Header>
                <views:LibraryView/>
            </TabItem>

            <TabItem Style="{DynamicResource MainTabItemStyle}">
                <TabItem.Header>Settings</TabItem.Header>
                <views:SettingsView/>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}">
            <Grid Margin="8 0">
                <TextBlock HorizontalAlignment="Left"
                           Text="{Binding StatusText}"
                           Style="{DynamicResource StatusTextStyle}"
                           VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right"
                           Text="{Binding EngineStatusText}"
                           Style="{DynamicResource StatusTextStyle}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
