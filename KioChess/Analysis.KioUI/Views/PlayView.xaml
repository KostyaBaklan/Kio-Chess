<UserControl x:Class="Analysis.KioUI.Views.PlayView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:prism="http://prismlibrary.com/"
xmlns:controls="clr-namespace:Analysis.KioUI.Views.Controls"
prism:ViewModelLocator.AutoWireViewModel="True"
Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Board area -->
            <ColumnDefinition Width="*" MinWidth="400"/>
            <!-- Side panel -->
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ?? Board column ????????????????????????????????? -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <!-- Opponent info + clock -->
                <RowDefinition Height="48"/>
                <!-- Board -->
                <RowDefinition Height="*"/>
                <!-- Player info + clock -->
                <RowDefinition Height="48"/>
                <!-- Action buttons -->
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Opponent (top) -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}"
                    Padding="12 6" Margin="0 0 0 4">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#9822;" FontSize="20"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   Margin="0 0 8 0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding OpponentName}"
                                       Style="{DynamicResource BodyTextStyle}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OpponentEloDisplay}"
                                       Style="{DynamicResource MutedTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Opponent clock -->
                    <TextBlock Text="{Binding OpponentClock}"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="20" FontFamily="Consolas"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Board control -->
            <controls:BoardControl Grid.Row="1"
                                   DataContext="{Binding Board}"
                                   Margin="0 4"/>

            <!-- Player (bottom) -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}"
                    Padding="12 6" Margin="0 4 0 0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#9812;" FontSize="20"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0 0 8 0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding PlayerName}"
                                       Style="{DynamicResource BodyTextStyle}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PlayerColorDisplay}"
                                       Style="{DynamicResource MutedTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Player clock -->
                    <TextBlock Text="{Binding PlayerClock}"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="20" FontFamily="Consolas"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0 8 0 0">
                <Button Content="New Game"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding NewGameCommand}"
                        Margin="0 0 8 0"/>
                <Button Content="Undo"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding UndoCommand}"
                        Margin="0 0 4 0"/>
                <Button Content="Redo"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding RedoCommand}"
                        Margin="0 0 8 0"/>
                <Button Content="Resign"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding ResignCommand}"
                        Margin="0 0 8 0"/>
                <Button Content="Draw"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding OfferDrawCommand}"
                        Margin="0 0 8 0"/>
                <Button Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding AnalyzeGameCommand}"
                        ToolTip="Open game in Analysis tab"
                        Padding="10 6">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,2 L2,8 L8,8 L8,2 Z M10,2 L10,8 L16,8 L16,2 Z M2,10 L2,16 L8,16 L8,10 Z M10,10 L10,16 L16,16 L16,10 Z" 
                              Fill="White" 
                              Stretch="Uniform" 
                              Width="14" Height="14"
                              Margin="0 0 6 0"/>
                        <TextBlock Text="Analyze" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Side panel -->
        <Grid Grid.Column="1" Margin="0 16 16 16">
            <Grid.RowDefinitions>
                <!-- Board evaluation -->
                <RowDefinition Height="Auto"/>
                <!-- Player's last move -->
                <RowDefinition Height="Auto"/>
                <!-- Engine's last move -->
                <RowDefinition Height="Auto"/>
                <!-- Current opening -->
                <RowDefinition Height="Auto"/>
                <!-- Status / thinking indicator -->
                <RowDefinition Height="Auto"/>
                <!-- Move list -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Board Evaluation Card -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0 0 0 8">
                <StackPanel>
                    <TextBlock Text="EVALUATION" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 4"/>
                    <TextBlock Text="{Binding BoardEvaluation}"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="28"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Player's Last Move Classification Card -->
            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0 0 0 8"
                    Visibility="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="YOUR LAST MOVE" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 4"/>
                    
                    <!-- Classification badge with icon -->
                    <Grid Margin="0 0 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Classification Icon Badge -->
                        <Border Grid.Column="0" 
                                Width="32" Height="32" 
                                CornerRadius="4" 
                                Margin="0 0 8 0"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                            </Border.Background>
                            <Path Data="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToIconPathConverter}}" 
                                  Fill="White" 
                                  Stroke="White"
                                  StrokeThickness="1"
                                  Stretch="Uniform" 
                                  Width="20" 
                                  Height="20"/>
                        </Border>
                        
                        <!-- Classification Text -->
                        <Border Grid.Column="1" 
                                CornerRadius="4" 
                                Padding="12 8"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding PlayerMoveClassification, Converter={StaticResource MoveClassificationToTextConverter}}"
                                       Style="{DynamicResource HeadingStyle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <!-- Best Move Sequence (shown for non-optimal moves) -->
                    <Border CornerRadius="4"
                            Padding="8 6"
                            Margin="0 0 0 0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Visibility="{Binding HasPlayerBestMoveSequence, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Better was:"
                                       Style="{DynamicResource MutedTextStyle}"
                                       FontSize="9"
                                       TextAlignment="Center"
                                       Margin="0 0 0 2"/>
                            <TextBlock Text="{Binding PlayerBestMoveSequence}"
                                       Style="{DynamicResource BodyTextStyle}"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Engine's Last Move Classification Card -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0 0 0 8"
                    Visibility="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="ENGINE'S LAST MOVE" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 4"/>
                    
                    <!-- Classification badge with icon -->
                    <Grid Margin="0 0 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Classification Icon Badge -->
                        <Border Grid.Column="0" 
                                Width="32" Height="32" 
                                CornerRadius="4" 
                                Margin="0 0 8 0"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                            </Border.Background>
                            <Path Data="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToIconPathConverter}}" 
                                  Fill="White" 
                                  Stroke="White"
                                  StrokeThickness="1"
                                  Stretch="Uniform" 
                                  Width="20" 
                                  Height="20"/>
                        </Border>
                        
                        <!-- Classification Text -->
                        <Border Grid.Column="1" 
                                CornerRadius="4" 
                                Padding="12 8"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding EngineMoveClassification, Converter={StaticResource MoveClassificationToTextConverter}}"
                                       Style="{DynamicResource HeadingStyle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <!-- Best Move Sequence (shown if engine made a mistake) -->
                    <Border CornerRadius="4"
                            Padding="8 6"
                            Margin="0 0 0 0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Visibility="{Binding HasEngineBestMoveSequence, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Better was:"
                                       Style="{DynamicResource MutedTextStyle}"
                                       FontSize="9"
                                       TextAlignment="Center"
                                       Margin="0 0 0 2"/>
                            <TextBlock Text="{Binding EngineBestMoveSequence}"
                                       Style="{DynamicResource BodyTextStyle}"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Current Opening Card -->
            <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Margin="0 0 0 8"
                    Visibility="{Binding HasOpeningData, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0 0 0 4">
                        <TextBlock Text="OPENING" 
                                   Style="{DynamicResource SubHeadingStyle}"
                                   HorizontalAlignment="Left"/>
                        
                        <!-- ECO code badge (when in book) -->
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="3"
                                Padding="4 2"
                                HorizontalAlignment="Right"
                                Visibility="{Binding CurrentOpeningECO, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInOpeningBook}" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentOpeningECO}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="10"/>
                        </Border>
                    </Grid>
                    
                    <!-- Opening name -->
                    <TextBlock Text="{Binding CurrentOpeningName}"
                               Style="{DynamicResource BodyTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0 0 0 4"/>
                    
                    <!-- Move sequence -->
                    <TextBlock Text="{Binding CurrentOpeningMoves}"
                               Style="{DynamicResource MutedTextStyle}"
                               FontSize="10"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Margin="0 0 0 4"/>
                    
                    <!-- "Out of book" indicator -->
                    <Border Background="#F0C15C"
                            CornerRadius="3"
                            Padding="6 3"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsInOpeningBook, Converter={StaticResource InverseBoolConverter}}">
                        <TextBlock Text="OUT OF BOOK"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="9"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Engine status card -->
            <Border Grid.Row="4" Style="{DynamicResource CardStyle}" Margin="0 0 0 8">
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 4"/>
                    <TextBlock Text="{Binding StatusText}"
                               Style="{DynamicResource BodyTextStyle}"
                               TextWrapping="Wrap"/>

                    <!-- Thinking spinner (visible while engine is thinking) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0 8 0 0"
                                Visibility="{Binding IsEngineThinking,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="16" Height="16"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Margin="0 0 8 0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="Engine thinking..."
                                   Style="{DynamicResource MutedTextStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Move list card -->
            <Border Grid.Row="5" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MOVES"
                               Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding MoveList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                              BorderThickness="0"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="False"
                              FontSize="12"
                              Foreground="{DynamicResource ForegroundBrush}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
                                <Setter Property="Padding"    Value="4 2"/>
                                <Setter Property="FontSize"   Value="11"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"     Binding="{Binding Number}" Width="28"/>
                            <DataGridTextColumn Header="White" Binding="{Binding White}"  Width="*"/>
                            <DataGridTextColumn Header="Black" Binding="{Binding Black}"  Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ?? Game-over overlay ???????????????????????????? -->
        <Border Grid.ColumnSpan="2"
                Background="#BB000000"
                Visibility="{Binding ShowGameOverOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="40 32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="300"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-60" To="0" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="3"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="0" To="1" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding GameResultText}"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding GameResultDetail}"
                               Style="{DynamicResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="New Game"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding NewGameCommand}"
                                Margin="0 0 8 0"/>
                        <Button Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding AnalyzeGameCommand}"
                                Margin="0 0 8 0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,2 L2,8 L8,8 L8,2 Z M10,2 L10,8 L16,8 L16,2 Z M2,10 L2,16 L8,16 L8,10 Z M10,10 L10,16 L16,16 L16,10 Z" 
                                      Fill="White" 
                                      Stretch="Uniform" 
                                      Width="14" Height="14"
                                      Margin="0 0 6 0"/>
                                <TextBlock Text="Analyze Game" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Review Board"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding DismissGameOverCommand}"
                                ToolTip="Close this dialog and review the final position"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
