<UserControl x:Class="StockfishBenchmark.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <DockPanel LastChildFill="True">

        <!-- ── Top: progress + status ── -->
        <Border DockPanel.Dock="Top" Background="White" Padding="14,10"
                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ElapsedText}"
                               FontSize="15" FontFamily="Consolas" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </DockPanel>
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                             Minimum="0" Maximum="100" Margin="0,0,0,8"/>

                <!-- Live stats strip -->
                <StackPanel Margin="0,0,0,8">
                    <!-- Current execution stats -->
                    <TextBlock Text="Current Execution" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <UniformGrid Rows="1">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                Padding="10,6" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Avg " FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding AvgDurationText}"
                                           FontFamily="Consolas" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                Padding="10,6" Margin="4,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Min " FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding MinDurationText}"
                                           FontFamily="Consolas" FontWeight="SemiBold"
                                           Foreground="#059669"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                Padding="10,6" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Max " FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding MaxDurationText}"
                                           FontFamily="Consolas" FontWeight="SemiBold"
                                           Foreground="#D97706"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- Baseline stats strip (until current move) -->
                <StackPanel>
                    <TextBlock Text="Baseline (Until Current Move)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <UniformGrid Rows="1">
                        <Border Background="#F0F9FF" CornerRadius="4"
                                Padding="10,6" Margin="0,0,4,0" BorderBrush="#0EA5E9" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Avg " FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding BaselineAvgDurationText}"
                                           FontFamily="Consolas" FontWeight="SemiBold"
                                           Foreground="#0EA5E9"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0F9FF" CornerRadius="4"
                                Padding="10,6" Margin="4,0" BorderBrush="#0EA5E9" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Min " FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding BaselineMinDurationText}"
                                           FontFamily="Consolas" FontWeight="SemiBold"
                                           Foreground="#059669"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0F9FF" CornerRadius="4"
                                Padding="10,6" Margin="4,0,0,0" BorderBrush="#0EA5E9" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Max " FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding BaselineMaxDurationText}"
                                           FontFamily="Consolas" FontWeight="SemiBold"
                                           Foreground="#D97706"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Success notification banner ── -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding IsSuccessNotificationVisible, Converter={StaticResource BoolToVis}}"
                Background="#D1FAE5" BorderBrush="#059669" BorderThickness="0,0,0,3"
                Padding="16,12" Margin="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✔" FontSize="16" FontWeight="Bold"
                           Foreground="#059669" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding NotificationText}"
                           FontWeight="SemiBold" FontSize="13.5"
                           Foreground="#065F46"/>
            </StackPanel>
        </Border>

        <!-- ── Warning / error notification banner ── -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding IsWarningNotificationVisible, Converter={StaticResource BoolToVis}}"
                Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="0,0,0,3"
                Padding="16,12" Margin="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="16" FontWeight="Bold"
                           Foreground="#D97706" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding NotificationText}"
                           FontWeight="SemiBold" FontSize="13.5"
                           Foreground="#92400E"/>
            </StackPanel>
        </Border>

        <!-- ── Bottom: action buttons ── -->
        <Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="{StaticResource ModernBorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← Back"        Width="90"  Margin="4,0" Command="{Binding BackCommand}"/>
                <Button Content="Cancel"          Width="90"  Margin="4,0" Command="{Binding CancelCommand}"/>
                <Button Content="Save Result"     Width="110" Margin="4,0" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"/>
                <Button Content="Compare →"       Width="110" Margin="4,0" Command="{Binding CompareCommand}"
                        IsEnabled="{Binding CanCompare}"/>
            </StackPanel>
        </Border>

        <!-- ── Centre: live DataGrid ── -->
        <DataGrid ItemsSource="{Binding LiveMoves}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  Margin="0">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEngineMove}" Value="True">
                            <Setter Property="Background" Value="#EEF4FF"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DBEAFE"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#BFDBFE"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="#"        Binding="{Binding MoveNumber}"   Width="45"/>
                <DataGridTextColumn Header="UCI"      Binding="{Binding UciMove}"      Width="70"/>
                <DataGridTextColumn Header="Move"     Binding="{Binding MoveNotation}" Width="100"/>
                <DataGridTextColumn Header="Type"     Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="IsEngineMove">
                            <Binding.Converter>
                                <StaticResource ResourceKey="BoolToEngineLabel"/>
                            </Binding.Converter>
                        </Binding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Duration"
                                    Binding="{Binding Duration, Converter={StaticResource DurationFmt}}"
                                    Width="150"/>
                <DataGridTextColumn Header="TT Count"
                                    Binding="{Binding TtCount, StringFormat={}{0:N0}}"
                                    Width="90"/>
                <DataGridTextColumn Header="Memory MB"
                                    Binding="{Binding ProcessMemoryMB, StringFormat={}{0:F1}}"
                                    Width="90"/>
                <DataGridTextColumn Header="Material"
                                    Binding="{Binding MaterialValue}"
                                    Width="80"/>
                <DataGridTextColumn Header="Static"
                                    Binding="{Binding StaticValue}"
                                    Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>

