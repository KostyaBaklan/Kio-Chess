<UserControl x:Class="Analysis.Kio.Analyzer.Views.AnalyseView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:prism="http://prismlibrary.com/"
xmlns:controls="clr-namespace:Analysis.UI.Common.Controls;assembly=Analysis.UI.Common"
xmlns:helpers="clr-namespace:Analysis.UI.Common.Helpers;assembly=Analysis.UI.Common"
prism:ViewModelLocator.AutoWireViewModel="True"
Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="520"/>
        </Grid.ColumnDefinitions>

        <!-- Board Area -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:BoardControl Grid.Row="0" DataContext="{Binding Board}" Margin="0 0 0 8"/>

            <!-- Navigation Controls -->
            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="8 6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button ToolTip="First move" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding GoToStartCommand}" Padding="10 6" Margin="0 0 4 0">
                        <Canvas Width="14" Height="12">
                            <Path Data="M0,0 L0,12" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2"/>
                            <Path Data="M10,0 L4,6 L10,12 Z" Fill="{DynamicResource ForegroundBrush}"/>
                        </Canvas>
                    </Button>
                    <Button ToolTip="Previous move" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding StepBackCommand}" Padding="10 6" Margin="0 0 4 0">
                        <Path Data="M8,0 L0,6 L8,12 Z" Fill="{DynamicResource ForegroundBrush}" Stretch="Uniform" Width="10" Height="12"/>
                    </Button>
                    <TextBlock Text="{Binding MoveIndexDisplay}" Style="{DynamicResource BodyTextStyle}"
                               VerticalAlignment="Center" MinWidth="90" TextAlignment="Center" Margin="4 0"/>
                    <Button ToolTip="Next move" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding StepForwardCommand}" Padding="10 6" Margin="4 0 4 0">
                        <Path Data="M0,0 L8,6 L0,12 Z" Fill="{DynamicResource ForegroundBrush}" Stretch="Uniform" Width="10" Height="12"/>
                    </Button>
                    <Button ToolTip="Last move" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding GoToEndCommand}" Padding="10 6">
                        <Canvas Width="14" Height="12">
                            <Path Data="M0,0 L6,6 L0,12 Z" Fill="{DynamicResource ForegroundBrush}"/>
                            <Path Data="M14,0 L14,12" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="2"/>
                        </Canvas>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Side Panel - Two Column Layout -->
        <Grid Grid.Column="1" Margin="0 16 16 16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Controls and Statistics -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Load Controls -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 8">
                        <StackPanel>
                            <TextBlock Text="LOAD GAME" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding LoadPgnCommand}" 
                                        Margin="0 0 4 0" Padding="12 6" ToolTip="Load PGN from file">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4,2 L4,14 M4,2 L10,2 L12,4 L12,14 L4,14 M10,2 L10,4 L12,4" 
                                              Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                              Margin="0 0 6 0" Width="14" Height="14"/>
                                        <TextBlock Text="PGN File" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding PastePgnCommand}" 
                                        Padding="12 6" ToolTip="Paste PGN from clipboard">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M2,2 L2,10 L6,10 L6,2 Z M6,6 L10,6 L10,14 L6,14" 
                                              Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                              Margin="0 0 6 0" Width="12" Height="14" Stretch="Uniform"/>
                                        <TextBlock Text="Paste PGN" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding LoadFenCommand}" Padding="12 6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,2 L14,2 M2,6 L10,6 M2,10 L12,10 M2,14 L8,14" 
                                          Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                          Margin="0 0 6 0" Width="14" Height="14"/>
                                    <TextBlock Text="FEN" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Analysis Controls -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 8">
                        <StackPanel>
                            <TextBlock Text="ANALYSIS" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                            <Grid Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Depth:" Style="{DynamicResource BodyTextStyle}" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                <Slider Grid.Column="1" Minimum="8" Maximum="24" Value="{Binding AnalysisDepth}"
                                        TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding AnalysisDepth}" Style="{DynamicResource BodyTextStyle}"
                                           FontWeight="SemiBold" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" Margin="8 0 0 0"/>
                            </Grid>
                            <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AnalyseGameCommand}"
                                    IsEnabled="{Binding IsNotAnalysing}" Padding="12 8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,0 A5,5 0 1,1 0,5 A5,5 0 1,1 10,5 M8.5,8.5 L12,12" 
                                          Stroke="White" StrokeThickness="2" Margin="0 0 8 0" Width="16" Height="16"/>
                                    <TextBlock Text="Analyze Game" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Visibility="{Binding IsAnalysing, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0 8 0 0">
                                <ProgressBar Value="{Binding AnalysisProgress}" Maximum="100" Height="4" Margin="0 0 0 4"/>
                                <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource MutedTextStyle}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0 8 0 0"
                                       Visibility="{Binding IsNotAnalysing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Accuracy Summary -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 8"
                            Visibility="{Binding HasAnalysisReport, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="ACCURACY" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                            <Grid Margin="0 0 0 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="W" Style="{DynamicResource BodyTextStyle}" FontWeight="Bold"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Height="12">
                                    <Border Background="#9BC53D" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding WhiteAccuracyBarWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding WhiteAccuracyText}" Style="{DynamicResource BodyTextStyle}" FontWeight="SemiBold" Margin="8 0 0 0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" Style="{DynamicResource BodyTextStyle}" FontWeight="Bold"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Height="12">
                                    <Border Background="#9BC53D" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BlackAccuracyBarWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding BlackAccuracyText}" Style="{DynamicResource BodyTextStyle}" FontWeight="SemiBold" Margin="8 0 0 0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Phase Accuracy -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 8"
                            Visibility="{Binding HasAnalysisReport, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="PHASE ACCURACY" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                            <!-- Opening -->
                            <TextBlock Text="Opening" Style="{DynamicResource MutedTextStyle}" FontSize="10" Margin="0 0 0 2"/>
                            <Grid Margin="0 0 0 2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="W" FontSize="9"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Height="8">
                                    <Border Background="#9BC53D" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding WhiteOpeningWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding WhiteOpeningDisplay}" FontSize="9" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0 0 0 6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" FontSize="9"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Height="8">
                                    <Border Background="#9BC53D" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BlackOpeningWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding BlackOpeningDisplay}" FontSize="9" TextAlignment="Right"/>
                            </Grid>
                            <!-- Middlegame -->
                            <TextBlock Text="Middlegame" Style="{DynamicResource MutedTextStyle}" FontSize="10" Margin="0 0 0 2"/>
                            <Grid Margin="0 0 0 2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="W" FontSize="9"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Height="8">
                                    <Border Background="#9BC53D" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding WhiteMiddlegameWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding WhiteMiddlegameDisplay}" FontSize="9" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0 0 0 6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" FontSize="9"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Height="8">
                                    <Border Background="#9BC53D" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BlackMiddlegameWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding BlackMiddlegameDisplay}" FontSize="9" TextAlignment="Right"/>
                            </Grid>
                            <!-- Endgame -->
                            <TextBlock Text="Endgame" Style="{DynamicResource MutedTextStyle}" FontSize="10" Margin="0 0 0 2"/>
                            <Grid Margin="0 0 0 2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="W" FontSize="9"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Height="8">
                                    <Border Background="#9BC53D" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding WhiteEndgameWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding WhiteEndgameDisplay}" FontSize="9" TextAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" FontSize="9"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Height="8">
                                    <Border Background="#9BC53D" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BlackEndgameWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding BlackEndgameDisplay}" FontSize="9" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Move Statistics -->
                    <Border Style="{DynamicResource CardStyle}"
                            Visibility="{Binding HasAnalysisReport, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="MOVE STATISTICS" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <!-- Header -->
                                <TextBlock Grid.Column="2" Text="W" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="B" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <!-- Brilliant -->
                                <Border Grid.Row="1" Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrilliantMoveBrush}" Margin="0 2">
                                    <Path Data="{StaticResource BrilliantIcon}" Fill="White" Stretch="Uniform" Width="10" Height="10"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Brilliant" FontSize="10" VerticalAlignment="Center" Margin="6 0"/>
                                <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Navigate to White Brilliant moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Brilliant,White"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding WhiteBrilliant}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Background="Transparent" Cursor="Hand" ToolTip="Navigate to Black Brilliant moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Brilliant,Black"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding BlackBrilliant}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>

                                <!-- Best -->
                                <Border Grid.Row="2" Width="12" Height="12" CornerRadius="2" Background="{StaticResource BestMoveBrush}" Margin="0 2">
                                    <Path Data="{StaticResource BestIcon}" Fill="White" Stretch="Uniform" Width="10" Height="10"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Best" FontSize="10" VerticalAlignment="Center" Margin="6 0"/>
                                <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Navigate to White Best moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Best,White"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding WhiteBestMoves}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" Background="Transparent" Cursor="Hand" ToolTip="Navigate to Black Best moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Best,Black"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding BlackBestMoves}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>

                                <!-- Excellent -->
                                <Border Grid.Row="3" Width="12" Height="12" CornerRadius="2" Background="{StaticResource ExcellentMoveBrush}" Margin="0 2" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.JumpToClassificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Excellent"/>
                                    </Border.InputBindings>
                                    <Path Data="{StaticResource ExcellentIcon}" Fill="White" Stretch="Uniform" Width="10" Height="10"/>
                                </Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Excellent" FontSize="10" VerticalAlignment="Center" Margin="6 0"/>
                                <Border Grid.Row="3" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Navigate to White Excellent moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Excellent,White"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding WhiteExcellent}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" Background="Transparent" Cursor="Hand" ToolTip="Navigate to Black Excellent moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Excellent,Black"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding BlackExcellent}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>

                                <!-- Good -->
                                <Border Grid.Row="4" Width="12" Height="12" CornerRadius="2" Background="{StaticResource GoodMoveBrush}" Margin="0 2">
                                    <Ellipse Width="6" Height="6" Fill="White"/>
                                </Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Good" FontSize="10" VerticalAlignment="Center" Margin="6 0"/>
                                <Border Grid.Row="4" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Navigate to White Good moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Good,White"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding WhiteGood}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" Background="Transparent" Cursor="Hand" ToolTip="Navigate to Black Good moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Good,Black"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding BlackGood}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>

                                <!-- Book -->
                                <Border Grid.Row="5" Width="12" Height="12" CornerRadius="2" Background="{StaticResource BookMoveBrush}" Margin="0 2">
                                    <Path Data="{StaticResource BookIcon}" Stroke="White" StrokeThickness="1" Stretch="Uniform" Width="10" Height="10"/>
                                </Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Book" FontSize="10" VerticalAlignment="Center" Margin="6 0"/>
                                <Border Grid.Row="5" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Navigate to White Book moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Book,White"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding WhiteBookMoves}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="3" Background="Transparent" Cursor="Hand" ToolTip="Navigate to Black Book moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Book,Black"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding BlackBookMoves}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>

                                <!-- Inaccuracy -->
                                <Border Grid.Row="6" Width="12" Height="12" CornerRadius="2" Background="{StaticResource InaccuracyMoveBrush}" Margin="0 2">
                                    <Path Data="{StaticResource InaccuracyIcon}" Fill="White" Stretch="Uniform" Width="8" Height="12"/>
                                </Border>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Inaccuracy" FontSize="10" VerticalAlignment="Center" Margin="6 0"/>
                                <Border Grid.Row="6" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Navigate to White Inaccuracy moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Inaccuracy,White"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding WhiteInaccuracies}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="3" Background="Transparent" Cursor="Hand" ToolTip="Navigate to Black Inaccuracy moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Inaccuracy,Black"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding BlackInaccuracies}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>

                                <!-- Mistake -->
                                <Border Grid.Row="7" Width="12" Height="12" CornerRadius="2" Background="{StaticResource MistakeMoveBrush}" Margin="0 2">
                                    <Path Data="{StaticResource MistakeIcon}" Fill="White" Stretch="Uniform" Width="10" Height="10"/>
                                </Border>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Mistake" FontSize="10" VerticalAlignment="Center" Margin="6 0"/>
                                <Border Grid.Row="7" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Navigate to White Mistake moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Mistake,White"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding WhiteMistakes}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="3" Background="Transparent" Cursor="Hand" ToolTip="Navigate to Black Mistake moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Mistake,Black"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding BlackMistakes}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                            </Grid>
                            <!-- Blunder row separate -->
                            <Grid Margin="0 2 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BlunderMoveBrush}">
                                    <Path Data="{StaticResource BlunderIcon}" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Blunder" FontSize="10" VerticalAlignment="Center" Margin="6 0"/>
                                <Border Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Navigate to White Blunder moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Blunder,White"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding WhiteBlunders}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                                <Border Grid.Column="3" Background="Transparent" Cursor="Hand" ToolTip="Navigate to Black Blunder moves">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMovesCommand}" CommandParameter="Blunder,Black"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding BlackBlunders}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                                </Border>
                            </Grid>

                            <!-- Move Filter Navigation Panel -->
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="4"
                                    Padding="8 6"
                                    Margin="0 8 0 0"
                                    Visibility="{Binding IsMoveFilterActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding MoveFilterText}" 
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0 0 0 6"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding PreviousFilteredMoveCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Padding="8 6" Margin="0 0 4 0"
                                                ToolTip="Previous filtered move">
                                            <Path Data="M8,1 L1,7 L8,13" 
                                                  Stroke="{DynamicResource ForegroundBrush}" 
                                                  StrokeThickness="2"
                                                  Stretch="Uniform" 
                                                  Width="10" Height="12"/>
                                        </Button>
                                        <Button Command="{Binding NextFilteredMoveCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Padding="8 6" Margin="0 0 4 0"
                                                ToolTip="Next filtered move">
                                            <Path Data="M1,1 L8,7 L1,13" 
                                                  Stroke="{DynamicResource ForegroundBrush}" 
                                                  StrokeThickness="2"
                                                  Stretch="Uniform" 
                                                  Width="10" Height="12"/>
                                        </Button>
                                        <Button Command="{Binding ClearMoveFilterCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Padding="8 6"
                                                ToolTip="Clear filter">
                                            <Path Data="M2,2 L12,12 M12,2 L2,12" 
                                                  Stroke="{DynamicResource ForegroundBrush}" 
                                                  StrokeThickness="2"
                                                  Stretch="Uniform" 
                                                  Width="10" Height="10"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Move Report -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header changes based on analysis state -->
                    <TextBlock Grid.Row="0" Margin="0 0 0 8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubHeadingStyle}">
                                <Setter Property="Text" Value="MOVES"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnalysisReport}" Value="True">
                                        <Setter Property="Text" Value="MOVE REPORT"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Analyzed Moves List (after analysis) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnalysisReport}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding AnalysedMovesList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0 0 0 4" Padding="10 8" CornerRadius="4" BorderThickness="2" Cursor="Hand"
                                            helpers:AutoScrollHelper.ScrollOnChange="{Binding IsCurrentMove}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding JumpToMoveCommand}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMove}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Move and classification badge -->
                                            <Grid Grid.Row="0" Margin="0 0 0 4">
                                                <TextBlock Text="{Binding MoveDisplay}" Style="{DynamicResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <Border Width="18" Height="18" CornerRadius="3" HorizontalAlignment="Right">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding Classification, Converter={StaticResource MoveClassificationToColorConverter}}"/>
                                                    </Border.Background>
                                                    <Path Fill="White" Stretch="Uniform" Width="14" Height="14">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Classification}" Value="Brilliant">
                                                                        <Setter Property="Data" Value="{StaticResource BrilliantIcon}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Classification}" Value="Best">
                                                                        <Setter Property="Data" Value="{StaticResource BestIcon}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Classification}" Value="Excellent">
                                                                        <Setter Property="Data" Value="{StaticResource ExcellentIcon}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Classification}" Value="Good">
                                                                        <Setter Property="Data" Value="{StaticResource GoodIcon}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Classification}" Value="Book">
                                                                        <Setter Property="Data" Value="{StaticResource BookIcon}"/>
                                                                        <Setter Property="Fill" Value="{x:Null}"/>
                                                                        <Setter Property="Stroke" Value="White"/>
                                                                        <Setter Property="StrokeThickness" Value="1"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Classification}" Value="Inaccuracy">
                                                                        <Setter Property="Data" Value="{StaticResource InaccuracyIcon}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Classification}" Value="Mistake">
                                                                        <Setter Property="Data" Value="{StaticResource MistakeIcon}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Classification}" Value="Blunder">
                                                                        <Setter Property="Data" Value="{StaticResource BlunderIcon}"/>
                                                                        <Setter Property="Fill" Value="{x:Null}"/>
                                                                        <Setter Property="Stroke" Value="White"/>
                                                                        <Setter Property="StrokeThickness" Value="1.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>
                                            </Grid>

                                            <!-- Evaluation and loss -->
                                            <Grid Grid.Row="1" Margin="0 0 0 2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding EvaluationAfterDisplay}" 
                                                           Style="{DynamicResource MutedTextStyle}" FontSize="10" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CentipawnLossDisplay}" 
                                                           Style="{DynamicResource MutedTextStyle}" FontSize="10" FontFamily="Consolas"
                                                           Foreground="#E58F2A"
                                                           Visibility="{Binding IsBestMoveDifferent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>

                                            <!-- Best continuation (shown for ALL moves) -->
                                            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Padding="6 4" Margin="0 4 0 0"
                                                    Visibility="{Binding HasContinuation, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="Best line:" Style="{DynamicResource MutedTextStyle}" FontSize="8" Margin="0 0 0 2"/>
                                                    <TextBlock Text="{Binding ContinuationSequence}" 
                                                               FontSize="9" 
                                                               FontFamily="Consolas" 
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Alternative move hint (only for mistakes) -->
                                            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Padding="6 4"
                                                    Visibility="{Binding HasBestMoveSequence, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="Better:" Style="{DynamicResource MutedTextStyle}" FontSize="8" Margin="0 0 0 2"/>
                                                    <TextBlock Text="{Binding BestMoveSequenceDisplay}" FontSize="9" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Simple move list (before analysis) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding MoveList}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="None" HeadersVisibility="Column" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                              BorderThickness="0" CanUserResizeColumns="False" CanUserSortColumns="False"
                              FontSize="11" Foreground="{DynamicResource ForegroundBrush}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnalysisReport}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
                                <Setter Property="Padding" Value="4 2"/>
                                <Setter Property="FontSize" Value="10"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="24"/>
                            <DataGridTextColumn Header="White" Binding="{Binding White}" Width="*"/>
                            <DataGridTextColumn Header="Black" Binding="{Binding Black}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>