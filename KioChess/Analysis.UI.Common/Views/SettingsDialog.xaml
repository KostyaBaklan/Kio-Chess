<Window x:Class="Analysis.UI.Common.Views.SettingsDialog"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:behaviors="clr-namespace:Analysis.UI.Common.Behaviors"
Title="Settings"
Width="700"
Height="750"
WindowStartupLocation="CenterOwner"
Style="{DynamicResource ShellWindowStyle}"
behaviors:WindowChromeBehavior.EnableCustomChrome="True"
Background="{DynamicResource SurfaceBrush}"
ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="32 24">
            <StackPanel MaxWidth="640">

                <!-- Engine Settings -->
                <TextBlock Text="ENGINE" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 12"/>
                <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 24" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Stockfish Executable Path"
                                   Style="{DynamicResource MutedTextStyle}" 
                                   FontSize="12"
                                   Margin="0 0 0 8"/>
                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding StockfishPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     Height="40"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Padding="12 0"
                                     Margin="0 0 8 0"/>
                            <Button Grid.Column="1"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Content="Browse..."
                                    Command="{Binding BrowseStockfishCommand}"
                                    Height="40"
                                    Padding="16 0"
                                    MinWidth="100"/>
                        </Grid>

                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Content="Test Stockfish Connection"
                                Command="{Binding TestStockfishCommand}"
                                HorizontalAlignment="Left"
                                Height="36"
                                Padding="16 0"
                                MinWidth="180"/>
                    </StackPanel>
                </Border>

                <!-- Appearance Settings -->
                <TextBlock Text="APPEARANCE" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 12"/>
                <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 24" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Theme"
                                   Style="{DynamicResource MutedTextStyle}" 
                                   FontSize="12"
                                   Margin="0 0 0 8"/>
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{DynamicResource ThemedComboBoxStyle}"
                                  Height="40"
                                  FontSize="13"
                                  Margin="0 0 0 16"/>

                        <TextBlock Text="Piece Set"
                                   Style="{DynamicResource MutedTextStyle}" 
                                   FontSize="12"
                                   Margin="0 0 0 8"/>
                        <ComboBox ItemsSource="{Binding PieceSets}"
                                  SelectedItem="{Binding SelectedPieceSet}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{DynamicResource ThemedComboBoxStyle}"
                                  Height="40"
                                  FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Sound Settings -->
                <TextBlock Text="SOUND" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 12"/>
                <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 24" Padding="20">
                    <StackPanel>
                        <CheckBox Content="Enable sounds"
                                  IsChecked="{Binding SoundEnabled}"
                                  Style="{DynamicResource ThemedCheckBoxStyle}"
                                  FontSize="13"
                                  Margin="0 0 0 16"/>

                        <TextBlock Text="Volume"
                                   Style="{DynamicResource MutedTextStyle}" 
                                   FontSize="12"
                                   Margin="0 0 0 8"/>
                        <Slider Minimum="0" 
                                Maximum="1"
                                Value="{Binding SoundVolume}"
                                IsEnabled="{Binding SoundEnabled}"
                                Style="{DynamicResource ThemedSliderStyle}"
                                TickFrequency="0.1" 
                                IsSnapToTickEnabled="True"
                                Margin="0 0 0 4"/>
                        <TextBlock Text="{Binding SoundVolume, StringFormat='{}{0:P0}'}"
                                   Style="{DynamicResource MutedTextStyle}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Animation Settings -->
                <TextBlock Text="ANIMATION" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 12"/>
                <Border Style="{DynamicResource CardStyle}" Margin="0 0 0 16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Animation Speed"
                                   Style="{DynamicResource MutedTextStyle}" 
                                   FontSize="12"
                                   Margin="0 0 0 8"/>
                        <ComboBox ItemsSource="{Binding AnimationSpeeds}"
                                  SelectedItem="{Binding AnimationSpeed}"
                                  Style="{DynamicResource ThemedComboBoxStyle}"
                                  Height="40"
                                  FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Status message -->
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="16 12"
                        Margin="0 8 0 0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{DynamicResource BodyTextStyle}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons bar -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0 1 0 0"
                Padding="32 20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Margin="0 0 12 0"
                        Height="44"
                        Padding="32 0"
                        FontSize="14"
                        MinWidth="120"/>
                <Button Content="Cancel"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Height="44"
                        Padding="32 0"
                        FontSize="14"
                        MinWidth="120"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>