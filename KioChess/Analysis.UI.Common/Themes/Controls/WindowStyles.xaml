<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === Window Control Buttons ================================ -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E81123"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- === Window / Dialog ======================================= -->
    <Style x:Key="ShellWindowStyle" TargetType="Window">
        <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="WindowStyle"     Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="ResizeMode"      Value="CanResizeWithGrip"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="32"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0"
                              CornerRadius="8"
                              UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" 
                                              Direction="270" 
                                              ShadowDepth="4" 
                                              BlurRadius="16" 
                                              Opacity="0.3"/>
                        </Border.Effect>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Custom Title Bar -->
                            <Border x:Name="TitleBar"
                                    Grid.Row="0" 
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0 0 0 1"
                                    CornerRadius="8 8 0 0">
                                <Grid Margin="12 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- App Icon & Title -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Window Icon (from .ico file) -->
                                        <Image Source="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                               Width="16" Height="16"
                                               Margin="0 0 6 0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        
                                        <!-- Fallback Unicode Chess Icon (if .ico not found) -->
                                        <TextBlock Text="&#9812;" 
                                                   FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" 
                                                   Margin="0 0 8 0"
                                                   Visibility="Collapsed"/>
                                        
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Window Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                        <!-- Minimize Button -->
                                        <Button x:Name="MinimizeButton"
                                                Style="{StaticResource WindowButtonStyle}"
                                                ToolTip="Minimize">
                                            <Path Data="M0,6 L10,6" 
                                                  Stroke="{DynamicResource ForegroundBrush}" 
                                                  StrokeThickness="1"/>
                                        </Button>
                                        
                                        <!-- Maximize/Restore Button -->
                                        <Button x:Name="MaximizeButton"
                                                Style="{StaticResource WindowButtonStyle}"
                                                ToolTip="Maximize">
                                            <Path x:Name="MaximizeIcon"
                                                  Data="M0,0 L10,0 L10,10 L0,10 Z" 
                                                  Stroke="{DynamicResource ForegroundBrush}" 
                                                  StrokeThickness="1"
                                                  Fill="Transparent"/>
                                        </Button>
                                        
                                        <!-- Close Button -->
                                        <Button x:Name="CloseButton"
                                                Style="{StaticResource WindowCloseButtonStyle}"
                                                ToolTip="Close">
                                            <Path Data="M0,0 L10,10 M10,0 L0,10" 
                                                  Stroke="{DynamicResource ForegroundBrush}" 
                                                  StrokeThickness="1"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Window Content -->
                            <ContentPresenter Grid.Row="1" Margin="0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
