<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rose Gold: blush tones with metallic rose -->

    <Color x:Key="AccentColor">#B76E79</Color>
    <Color x:Key="AccentLightColor">#E8A0A8</Color>
    <Color x:Key="ShellBackgroundColor">#2A1A1C</Color>
    <Color x:Key="SurfaceColor">#382224</Color>
    <Color x:Key="SurfaceAltColor">#452A2E</Color>
    <Color x:Key="BorderColor">#6A3840</Color>
    <Color x:Key="ForegroundColor">#FAF0F0</Color>
    <Color x:Key="ForegroundMutedColor">#C8A0A8</Color>
    <Color x:Key="TabActiveColor">#3E2428</Color>
    <Color x:Key="TabHoverColor">#321C20</Color>
    <Color x:Key="StatusBarColor">#180E10</Color>

    <Color x:Key="BoardLightSquareColor">#F9E8EC</Color>
    <Color x:Key="BoardDarkSquareColor">#C48090</Color>
    <Color x:Key="BoardHighlightColor">#AAFF90A0</Color>
    <Color x:Key="BoardLastMoveColor">#AAFF80B0</Color>
    <Color x:Key="BoardSelectedColor">#AAFF6080</Color>
    <Color x:Key="BoardCheckColor">#AADC143C</Color>
    <Color x:Key="BoardValidTargetColor">#88CC4060</Color>

    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush"      Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="ShellBackgroundBrush"  Color="{StaticResource ShellBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush"       Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ForegroundBrush"       Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="ForegroundMutedBrush"  Color="{StaticResource ForegroundMutedColor}" />
    <SolidColorBrush x:Key="TabActiveBrush"        Color="{StaticResource TabActiveColor}" />
    <SolidColorBrush x:Key="TabHoverBrush"         Color="{StaticResource TabHoverColor}" />
    <SolidColorBrush x:Key="StatusBarBrush"        Color="{StaticResource StatusBarColor}" />

    <SolidColorBrush x:Key="BoardLightSquareBrush" Color="{StaticResource BoardLightSquareColor}" />
    <SolidColorBrush x:Key="BoardDarkSquareBrush"  Color="{StaticResource BoardDarkSquareColor}" />
    <SolidColorBrush x:Key="BoardHighlightBrush"   Color="{StaticResource BoardHighlightColor}" />
    <SolidColorBrush x:Key="BoardLastMoveBrush"    Color="{StaticResource BoardLastMoveColor}" />
    <SolidColorBrush x:Key="BoardSelectedBrush"    Color="{StaticResource BoardSelectedColor}" />
    <SolidColorBrush x:Key="BoardCheckBrush"       Color="{StaticResource BoardCheckColor}" />
    <SolidColorBrush x:Key="BoardValidTargetBrush" Color="{StaticResource BoardValidTargetColor}" />

</ResourceDictionary>
