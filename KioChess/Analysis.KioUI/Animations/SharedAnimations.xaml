<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared animation Storyboards used across the application. -->

    <!-- Fade in (0 to 1 over 200 ms) -->
    <Storyboard x:Key="FadeInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.2"/>
    </Storyboard>

    <!-- Fade out (1 to 0 over 150 ms) -->
    <Storyboard x:Key="FadeOutStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.15"/>
    </Storyboard>

    <!-- Tab content cross-fade -->
    <Storyboard x:Key="TabFadeInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Piece move slide duration (From/To values are set in code-behind) -->
    <Duration x:Key="PieceSlideDuration">0:0:0.18</Duration>

    <!-- Check flash: king cell background pulses red twice -->
    <Storyboard x:Key="CheckFlashStoryboard" RepeatBehavior="2x" AutoReverse="True">
        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                        To="#AADC143C" Duration="0:0:0.25"/>
    </Storyboard>

    <!-- Capture pop: captured piece shrinks to zero and fades out -->
    <Storyboard x:Key="CapturePopStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="1" To="0" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseIn" Amplitude="0.3"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="1" To="0" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseIn" Amplitude="0.3"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.15"/>
    </Storyboard>

    <!-- Game-over banner: slides down from top and fades in -->
    <Storyboard x:Key="GameOverBannerStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="-80" To="0" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="3"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.3"/>
    </Storyboard>

    <!-- Thinking indicator: infinite rotation for a spinner element -->
    <Storyboard x:Key="ThinkingRotateStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0" To="360" Duration="0:0:1.2"/>
    </Storyboard>

    <!-- Move highlight fade-out: begins after 2 seconds -->
    <Storyboard x:Key="MoveHighlightFadeStoryboard" BeginTime="0:0:2">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.6"/>
    </Storyboard>

</ResourceDictionary>
