<Window x:Class="StockfishBenchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="StockfishBenchmark — Kio-Chess Performance Tool"
        Width="1280" Height="860"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">

        <!-- ── App header bar ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource HeaderGradient}"
                Padding="20,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="♞" FontSize="26" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Kio-Chess Benchmark" FontSize="19"
                           FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="Performance Analysis Tool"
                           FontSize="12" Foreground="#AAC4E8"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentView}"/>
    </DockPanel>
</Window>

