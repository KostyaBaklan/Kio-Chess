<UserControl x:Class="Analysis.Kio.OpeningsExplorer.Views.OpeningExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:Analysis.UI.Common.Controls;assembly=Analysis.UI.Common"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource SurfaceBrush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="480" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Board Area -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Current Opening Card -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0 0 0 8" Padding="12 8">
                <StackPanel>
                    <Grid Margin="0 0 0 4">
                        <TextBlock Text="{Binding CurrentOpeningName}"
                                   Style="{DynamicResource HeadingStyle}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"/>
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="3"
                                Padding="6 3"
                                HorizontalAlignment="Right"
                                Visibility="{Binding ECOCode, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding ECOCode}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Border>
                    </Grid>
                    
                    <TextBlock Text="{Binding MoveHistory}"
                               Style="{DynamicResource MutedTextStyle}"
                               FontSize="11"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Visibility="{Binding MoveHistory, Converter={StaticResource StringToVisibilityConverter}}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                        <TextBlock Text="Depth: "
                                   Style="{DynamicResource MutedTextStyle}"
                                   FontSize="10"/>
                        <TextBlock Text="{Binding Depth}"
                                   Style="{DynamicResource BodyTextStyle}"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text=" moves"
                                   Style="{DynamicResource MutedTextStyle}"
                                   FontSize="10"
                                   Margin="2 0 0 0"/>
                        <Border Background="#4CAF50"
                                CornerRadius="2"
                                Padding="4 1"
                                Margin="8 0 0 0"
                                Visibility="{Binding IsInBook, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="IN BOOK"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Board -->
            <controls:BoardControl Grid.Row="1" DataContext="{Binding Board}" Margin="0 0 0 8"/>

            <!-- Navigation Controls -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="8 6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Reset" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding ResetCommand}" Padding="12 6" Margin="0 0 8 0"/>
                    <Button ToolTip="Previous move" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding PreviousMoveCommand}" Padding="10 6">
                        <Path Data="M8,0 L0,6 L8,12 Z" 
                              Fill="{DynamicResource ForegroundBrush}" 
                              Stretch="Uniform" 
                              Width="10" Height="12"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Explorer Panel -->
        <Grid Grid.Column="1" Margin="0 16 16 16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0 0 0 8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="SEARCH OPENINGS" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                    
                    <Grid Grid.Row="1">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 Tag="Type: Sicilian, B20, Italian Game..."
                                 Height="40"
                                 FontSize="13"
                                 Padding="40 0 12 0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <Path Data="M9,2 A7,7 0 1,1 9,16 A7,7 0 1,1 9,2 M15,15 L19,19" 
                              Stroke="{DynamicResource ForegroundMutedBrush}" 
                              StrokeThickness="2"
                              Stretch="Uniform" 
                              Width="16" Height="16"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="10 0 0 0"
                              IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Autocomplete Suggestions -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0 2 0 0"
                            Padding="4"
                            Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SearchSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8 6"
                                                Background="Transparent"
                                                CornerRadius="3"
                                                Cursor="Hand"
                                                Margin="0 1">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            
                                            <!-- Use ContentControl with MultiBinding for highlighted text -->
                                            <ContentControl VerticalAlignment="Center">
                                                <ContentControl.Content>
                                                    <MultiBinding Converter="{StaticResource HighlightTextConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.SearchQuery" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </ContentControl.Content>
                                            </ContentControl>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Search Results -->
            <Border Grid.Row="1" 
                    Style="{DynamicResource CardStyle}" 
                    Margin="0 0 0 8"
                    Visibility="{Binding IsSearchExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="SEARCH RESULTS" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                    
                    <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0 0 0 2"
                                            Padding="8 6"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="3"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.JumpToOpeningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Display}"
                                                       Style="{DynamicResource BodyTextStyle}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Moves}"
                                                       Style="{DynamicResource MutedTextStyle}"
                                                       FontSize="10"
                                                       FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status/Import Card -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0 0 0 8">
                <StackPanel>
                    <TextBlock Text="DATABASE STATUS" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{DynamicResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding TotalOpeningsDisplay}"
                               Style="{DynamicResource MutedTextStyle}"
                               FontSize="11"
                               Margin="0 0 0 8"
                               Visibility="{Binding IsDatabaseInitialized, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Import Opening Data"
                            Command="{Binding ImportDataCommand}"
                            HorizontalAlignment="Stretch"
                            Height="32">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDatabaseInitialized}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Possible Moves -->
            <Border Grid.Row="3" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="POSSIBLE MOVES" Style="{DynamicResource SubHeadingStyle}" Margin="0 0 0 8"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PossibleMoves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0 0 0 4"
                                            Padding="10 8"
                                            CornerRadius="4"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding PlayMoveCommand}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMainLine}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding MoveSAN}"
                                                       Style="{DynamicResource BodyTextStyle}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OpeningName}"
                                                       Style="{DynamicResource BodyTextStyle}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8 0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ECO}"
                                                       Style="{DynamicResource MutedTextStyle}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
