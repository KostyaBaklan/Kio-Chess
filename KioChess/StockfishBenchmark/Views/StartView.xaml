<UserControl x:Class="StockfishBenchmark.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="560" Margin="20,60,20,20" HorizontalAlignment="Center">
        <TextBlock Text="Choose a benchmark" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <Button Command="{Binding OpenPerformanceCommand}" Padding="20,14" Margin="0,0,0,12" HorizontalContentAlignment="Left">
            <StackPanel>
                <TextBlock Text="Performance benchmark" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Play vs Stockfish or replay a baseline; compare search time, TT count and memory."
                           Foreground="#DDE7F5" TextWrapping="Wrap"/>
            </StackPanel>
        </Button>

        <Button Command="{Binding OpenTtStatisticsCommand}" Padding="20,14" HorizontalContentAlignment="Left">
            <StackPanel>
                <TextBlock Text="Transposition table statistics" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Replay one game with different TT sizes and generation modes; hits, replacements, ages, slots, advice."
                           Foreground="#DDE7F5" TextWrapping="Wrap"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
