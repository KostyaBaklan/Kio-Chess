<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net9.0-windows7.0</TargetFramework>
  <Nullable>disable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <UseWPF>true</UseWPF>
  <RootNamespace>Analysis.Kio.Analyzer</RootNamespace>
    
  <!-- Common output folder for all Analysis apps -->
  <OutputPath>..\Analysis\</OutputPath>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  <ApplicationIcon>chess-analysis-1.ico</ApplicationIcon>
</PropertyGroup>

<ItemGroup>
  <Content Include="chess-analysis-1.ico" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Analysis.UI.Common\Analysis.UI.Common.csproj" />
  </ItemGroup>

</Project>
