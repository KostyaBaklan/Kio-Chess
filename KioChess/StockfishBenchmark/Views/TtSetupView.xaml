<UserControl x:Class="StockfishBenchmark.Views.TtSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="640" Margin="20" HorizontalAlignment="Center">

            <TextBlock Text="{Binding StatsBuildText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <GroupBox Header="Game source" Margin="0,0,0,10">
                <StackPanel Margin="8">
                    <RadioButton Content="New game vs Stockfish (recorded, then replayed for every variant)"
                                 IsChecked="{Binding IsNewGame, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <RadioButton Content="Load recorded game (benchmark JSON)"
                                 IsChecked="{Binding IsLoadMode, Mode=TwoWay}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="New game" Margin="0,0,0,10"
                      Visibility="{Binding IsNewGame, Converter={StaticResource BoolToVis}}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Strategy:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}"/>
                    <Label Grid.Row="1" Content="Depth:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Depths}" SelectedItem="{Binding SelectedDepth}"/>
                    <Label Grid.Row="2" Content="Engine color:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" ItemsSource="{Binding ColorLabels}" SelectedItem="{Binding SelectedColorLabel}"/>
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,3" Foreground="Gray" Text="The game is played until checkmate, stalemate or a draw (no move limit)."/>
                    <Label Grid.Row="4" Content="Stockfish depth:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Text="{Binding StockfishDepth, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Row="5" Content="Stockfish ELO:"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3" Text="{Binding StockfishElo, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Recorded game" Margin="0,0,0,10"
                      Visibility="{Binding IsLoadMode, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="8" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Browse..." Width="80" Margin="6,0,0,0" Command="{Binding LoadFileCommand}"/>
                    <TextBox IsReadOnly="True" Text="{Binding LoadedFilePath, Mode=OneWay}" VerticalAlignment="Center"/>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Variants (every combination is replayed on the same positions)" Margin="0,0,0,10">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Main TT sizes (MB):"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3" Text="{Binding MainSizes, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma separated, per colour. 0 = engine default for the depth. Example: 0,128,64,32"/>
                    <Label Grid.Row="1" Content="Null TT sizes (MB):"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding NullSizes, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma separated, per colour. 0 = engine default for the depth. Example: 0,64,128"/>
                    <Label Grid.Row="2" Content="Depth factors:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding DepthFactors, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma separated shift of the depth term in the replacement priority: (depth &lt;&lt; factor) + generation. -1 = Configuration.json. Example: -1,2,3,4,6"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6" TextWrapping="Wrap" Foreground="Gray"
                               Text="Every size pair x depth factor is replayed on the same positions, always with generation on. Run the tool once per search depth: the dashboard keeps all runs of the session so depths can be compared."/>
                </Grid>
            </GroupBox>

            <TextBlock Text="{Binding ValidationMessage}" Foreground="Red" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ValidationMessage, Converter={StaticResource EmptyToCollapsed}}"/>

            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Back" Padding="20,6" Command="{Binding BackCommand}"/>
                <Button DockPanel.Dock="Right" Content="Start" Padding="20,6" Command="{Binding StartCommand}"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
