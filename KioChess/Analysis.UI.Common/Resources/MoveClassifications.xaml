<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:sys="clr-namespace:System;assembly=System.Runtime"
xmlns:models="clr-namespace:Analysis.Core.Models;assembly=Analysis.Core">

    <!-- Move Classification Colors (similar to chess.com) -->
    <SolidColorBrush x:Key="BrilliantMoveBrush" Color="#1BACA6"/>      <!-- Teal/Cyan -->
    <SolidColorBrush x:Key="BestMoveBrush" Color="#9BC53D"/>           <!-- Lime green -->
    <SolidColorBrush x:Key="ExcellentMoveBrush" Color="#5AC18E"/>      <!-- Green-cyan -->
    <SolidColorBrush x:Key="GoodMoveBrush" Color="#96AF8B"/>           <!-- Neutral green -->
    <SolidColorBrush x:Key="BookMoveBrush" Color="#A88865"/>           <!-- Brown/tan -->
    <SolidColorBrush x:Key="InaccuracyMoveBrush" Color="#F0C15C"/>     <!-- Yellow -->
    <SolidColorBrush x:Key="MistakeMoveBrush" Color="#E58F2A"/>        <!-- Orange -->
    <SolidColorBrush x:Key="BlunderMoveBrush" Color="#CA3431"/>        <!-- Red -->

    <!-- Move Classification Icon Geometries -->
    
    <!-- Brilliant: Star/sparkle -->
    <PathGeometry x:Key="BrilliantIcon" Figures="M7,2 L9,6 L13,7 L10,10 L11,14 L7,12 L3,14 L4,10 L1,7 L5,6 Z"/>

    <!-- Best: Upward arrow -->
    <PathGeometry x:Key="BestIcon" Figures="M3,8 L7,3 L11,8 L9,8 L9,13 L5,13 L5,8 Z"/>

    <!-- Excellent: Checkmark -->
    <PathGeometry x:Key="ExcellentIcon" Figures="M7,13 L2,5 L5,5 L7,8 L9,5 L12,5 Z"/>

    <!-- Good: Small circle -->
    <EllipseGeometry x:Key="GoodIcon" Center="7,7" RadiusX="3" RadiusY="3"/>

    <!-- Book: Open book -->
    <PathGeometry x:Key="BookIcon" Figures="M2,2 L2,14 L6,12 L8,14 L10,12 L14,14 L14,2 Z M8,2 L8,13"/>

    <!-- Inaccuracy: Exclamation mark -->
    <PathGeometry x:Key="InaccuracyIcon" Figures="M6,2 L8,2 L8,9 L6,9 Z M6,11 L8,11 L8,13 L6,13 Z"/>

    <!-- Mistake: Downward arrow -->
    <PathGeometry x:Key="MistakeIcon" Figures="M3,8 L7,13 L11,8 L9,8 L9,3 L5,3 L5,8 Z"/>

    <!-- Blunder: X marks -->
    <PathGeometry x:Key="BlunderIcon" Figures="M2,2 L6,6 M6,2 L2,6 M10,2 L14,6 M14,2 L10,6 M3,8 L7,13 L11,8"/>

    <!-- Move Classification Icon Path Data (string format for Path.Data binding) -->
    <sys:String x:Key="BrilliantIconPath">M7,1 L8,5 L12,6 L9,9 L10,13 L7,11 L4,13 L5,9 L2,6 L6,5 Z</sys:String>
    <sys:String x:Key="BestIconPath">M3,8 L7,3 L11,8 L9,8 L9,13 L5,13 L5,8 Z</sys:String>
    <sys:String x:Key="ExcellentIconPath">M2,7 L6,12 L12,2</sys:String>
    <sys:String x:Key="GoodIconPath">M7,7 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0</sys:String>
    <sys:String x:Key="BookIconPath">M2,2 L2,14 L6,12 L8,14 L10,12 L14,14 L14,2 Z M8,2 L8,13</sys:String>
    <sys:String x:Key="InaccuracyIconPath">M6,2 L8,2 L8,9 L6,9 Z M6,11 L8,11 L8,13 L6,13 Z</sys:String>
    <sys:String x:Key="MistakeIconPath">M3,6 L7,11 L11,6 L9,6 L9,3 L5,3 L5,6 Z</sys:String>
    <sys:String x:Key="BlunderIconPath">M2,2 L6,6 M6,2 L2,6 M10,2 L14,6 M14,2 L10,6</sys:String>

    <!-- Move Classification Colors (string format for SolidColorBrush.Color binding) -->
    <sys:String x:Key="BrilliantColor">#1BACA6</sys:String>
    <sys:String x:Key="BestColor">#9BC53D</sys:String>
    <sys:String x:Key="ExcellentColor">#5AC18E</sys:String>
    <sys:String x:Key="GoodColor">#96AF8B</sys:String>
    <sys:String x:Key="BookColor">#A88865</sys:String>
    <sys:String x:Key="InaccuracyColor">#F0C15C</sys:String>
    <sys:String x:Key="MistakeColor">#E58F2A</sys:String>
    <sys:String x:Key="BlunderColor">#CA3431</sys:String>

    <!-- Move Classification Text Symbols (chess annotation) -->
    <sys:String x:Key="BrilliantSymbol">!!</sys:String>
    <sys:String x:Key="BestSymbol">?</sys:String>
    <sys:String x:Key="ExcellentSymbol">!</sys:String>
    <sys:String x:Key="GoodSymbol">?</sys:String>
    <sys:String x:Key="BookSymbol">?</sys:String>
    <sys:String x:Key="InaccuracySymbol">?!</sys:String>
    <sys:String x:Key="MistakeSymbol">?</sys:String>
    <sys:String x:Key="BlunderSymbol">??</sys:String>

    <!-- Move Classification Text Labels -->
    <sys:String x:Key="BrilliantText">Brilliant!!</sys:String>
    <sys:String x:Key="BestText">Best</sys:String>
    <sys:String x:Key="ExcellentText">Excellent!</sys:String>
    <sys:String x:Key="GoodText">Good</sys:String>
    <sys:String x:Key="BookText">Book</sys:String>
    <sys:String x:Key="InaccuracyText">Inaccuracy</sys:String>
    <sys:String x:Key="MistakeText">Mistake</sys:String>
    <sys:String x:Key="BlunderText">Blunder!!</sys:String>

    <!-- Data Templates for Move Classification Badges -->
    
    <!-- Brilliant Badge -->
    <DataTemplate x:Key="BrilliantBadge">
        <Border Width="14" Height="14" Background="{StaticResource BrilliantMoveBrush}" CornerRadius="2">
            <Path Data="{StaticResource BrilliantIcon}" 
                  Fill="White" Stretch="Uniform" Width="10" Height="10"/>
        </Border>
    </DataTemplate>

    <!-- Best Badge -->
    <DataTemplate x:Key="BestBadge">
        <Border Width="14" Height="14" Background="{StaticResource BestMoveBrush}" CornerRadius="2">
            <Path Data="{StaticResource BestIcon}" 
                  Fill="White" Stretch="Uniform" Width="10" Height="10"/>
        </Border>
    </DataTemplate>

    <!-- Excellent Badge -->
    <DataTemplate x:Key="ExcellentBadge">
        <Border Width="14" Height="14" Background="{StaticResource ExcellentMoveBrush}" CornerRadius="2">
            <Path Data="{StaticResource ExcellentIcon}" 
                  Fill="White" Stretch="Uniform" Width="10" Height="10"/>
        </Border>
    </DataTemplate>

    <!-- Good Badge -->
    <DataTemplate x:Key="GoodBadge">
        <Border Width="14" Height="14" Background="{StaticResource GoodMoveBrush}" CornerRadius="2">
            <Ellipse Width="6" Height="6" Fill="White"/>
        </Border>
    </DataTemplate>

    <!-- Book Badge -->
    <DataTemplate x:Key="BookBadge">
        <Border Width="14" Height="14" Background="{StaticResource BookMoveBrush}" CornerRadius="2">
            <Path Data="{StaticResource BookIcon}" 
                  Stroke="White" StrokeThickness="1"
                  Stretch="Uniform" Width="10" Height="10"/>
        </Border>
    </DataTemplate>

    <!-- Inaccuracy Badge -->
    <DataTemplate x:Key="InaccuracyBadge">
        <Border Width="14" Height="14" Background="{StaticResource InaccuracyMoveBrush}" CornerRadius="2">
            <Path Data="{StaticResource InaccuracyIcon}" 
                  Fill="White" Stretch="Uniform" Width="8" Height="12"/>
        </Border>
    </DataTemplate>

    <!-- Mistake Badge -->
    <DataTemplate x:Key="MistakeBadge">
        <Border Width="14" Height="14" Background="{StaticResource MistakeMoveBrush}" CornerRadius="2">
            <Path Data="{StaticResource MistakeIcon}" 
                  Fill="White" Stretch="Uniform" Width="10" Height="10"/>
        </Border>
    </DataTemplate>

    <!-- Blunder Badge -->
    <DataTemplate x:Key="BlunderBadge">
        <Border Width="14" Height="14" Background="{StaticResource BlunderMoveBrush}" CornerRadius="2">
            <Path Data="{StaticResource BlunderIcon}" 
                  Stroke="White" StrokeThickness="1.5"
                  Stretch="Uniform" Width="12" Height="12"/>
        </Border>
    </DataTemplate>

</ResourceDictionary>
