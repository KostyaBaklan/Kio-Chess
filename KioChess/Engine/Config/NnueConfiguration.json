{
    "IsEnabled": false, // false = hand-crafted evaluation
    "NetworkPath": "Config\\kio.nnue",
    "Network": {
      "Inputs": 768,
      "Hidden": 256,
      "QA": 255,
      "QB": 64,
      "Scale": 400,
      "MaxEvaluation": 20000, // clamp of NNUE output, must stay below Mate - DynamicGameDepth
      "UseEvaluationCache": false,
      "UseEndGameAdjustments": true
    },
    "Data": {
      "SourceDirectory": "C:\\Dev\\PGN",
      "OutputDirectory": "C:\\Dev\\NNUE\\Data",
      "FilteredFile": "filtered.pgn",
      "Filter": {
        "MinElo": 2000,
        "MinBaseTimeSeconds": 180,
        "ExcludeBots": true,
        "AllowedTerminations": [ "Normal", "Time forfeit" ]
      },
      "Extract": {
        "MinPly": 16,
        "MaxPly": 160, // replay limit, keeps search plies below DynamicGameDepth
        "SampleRate": 0.5,
        "SkipInCheck": true,
        "SkipNonQuiet": true,
        "BloomFilterBits": 27,
        "Seed": 1
      },
      "Label": {
        "Strategy": "lmrd",
        "Depth": 6,
        "MaxAbsScore": 3000,
        "SkipCaptureBestMove": true,
        "ClearTablePerGame": true,
        "Workers": 18, // 0 = Environment.ProcessorCount * 3 / 4
        "RangesPerWorker": 8,
        "MaxHours": 18,
        "FlushPositions": 100000,
        "ReportGames": 25,
        "BufferSize": 16
      },
      "Merge": {
        "ValidationRate": 0.01,
        "MaxPoolPositions": 100000000, // 32 bytes per position in memory
        "Seed": 7
      }
    },
    "Training": {
      "TrainPath": "C:\\Dev\\NNUE\\Data\\train.bin",
      "ValidationPath": "C:\\Dev\\NNUE\\Data\\val.bin",
      "OutputDirectory": "C:\\Dev\\NNUE\\Nets",
      "Threads": 10,
      "BatchSize": 16384,
      "Epochs": 15,
      "LearningRate": 0.001,
      "FinalLearningRate": 0.00001,
      "WeightDecay": 0.0,
      "Lambda": 0.75,
      "WeightClip": 1.98,
      "Seed": 42,
      "MaxHours": 17,
      "ChunkEpochs": 2, // epochs per monthly chunk in pipeline mode (--chunk)
      "ChunkLearningRateFactor": 0.3 // peak LR multiplier for chunks after the first
    }
}

