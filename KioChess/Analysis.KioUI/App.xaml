<common:UiApp x:Class="Analysis.KioUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:common="clr-namespace:UI.Common;assembly=UI.Common"
             xmlns:local="clr-namespace:Analysis.KioUI">
    <common:UiApp.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Value converters -->
                <ResourceDictionary Source="Converters/Converters.xaml"/>
                <!-- Piece vector geometry sets -->
                <ResourceDictionary Source="Themes/PieceGeometries.xaml"/>
                <!-- Move classifications (colors, icons, badges) -->
                <ResourceDictionary Source="Resources/MoveClassifications.xaml"/>
                <!-- Global control styles (theme-agnostic structure) -->
                <ResourceDictionary Source="Themes/ControlStyles.xaml"/>
                <!-- Default theme, replaced at runtime by ThemeService -->
                <ResourceDictionary Source="Themes/ClassicWood/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </common:UiApp.Resources>
</common:UiApp>
