<Window x:Class="Analysis.UI.Common.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:Analysis.UI.Common.Behaviors"
        mc:Ignorable="d"
        Style="{DynamicResource ShellWindowStyle}"
        behaviors:WindowChromeBehavior.EnableCustomChrome="True"
        Height="750" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0 0 0 1">
            <Grid Margin="16 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#9812;" FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <TextBlock x:Name="TitleText"
                               Style="{DynamicResource HeadingStyle}"
                               FontSize="15"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0 0 4 0">
                    <TextBlock Text="Theme:"
                               Style="{DynamicResource MutedTextStyle}"
                               VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <ComboBox x:Name="ThemeComboBox"
                              Style="{DynamicResource ThemedComboBoxStyle}"
                              Width="140" Height="28"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="OnThemeChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area - filled by derived window -->
        <ContentPresenter x:Name="MainContent" Grid.Row="1"/>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}">
            <Grid Margin="8 0">
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Left"
                           Style="{DynamicResource StatusTextStyle}"
                           VerticalAlignment="Center"
                           Text="Ready"/>
                <TextBlock x:Name="EngineStatusText"
                           HorizontalAlignment="Right"
                           Style="{DynamicResource StatusTextStyle}"
                           VerticalAlignment="Center"
                           Text="Engine: offline"/>
            </Grid>
        </Border>
    </Grid>
</Window>
